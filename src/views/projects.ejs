<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <h2>Upcoming Service Projects</h2>
        <ul>
            <% serviceProjects.forEach(serviceProject => { %>
                <li>
                    <%= serviceProject.date.toDateString() %>- <%= serviceProject.title %>! Run by: <strong><%= serviceProject.organization_name %></strong>
                    <br>
                    <%= serviceProject.description %> At <%= serviceProject.location %>                    
                </li>
            <% }); %>
        </ul>
    </main>
<%- include('partials/footer') %>