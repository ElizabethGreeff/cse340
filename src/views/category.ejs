<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>
        <h2 >
            <%= category.name %>
        </h2>
        <p class="page-intro">Service projects in this category.</p>

        <% if (projects.length > 0) { %>
            <ul class="project-list">
                <% projects.forEach(project => { %>
                    <li class="project-item">
                        <a href="/project/<%= project.project_id %>" class="project-link">
                            <%= project.title %>
                        </a>
                    </li>
                <% }); %>
            </ul>
        <% } else { %>
            <p>No projects found in this category.</p>
        <% } %>

        <p><a href="/categories" class="back-link">Back to Categories</a></p>
        
    </main>

<%- include('partials/footer') %>