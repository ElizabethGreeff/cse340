<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <article class="detail-card">
            <p class="detail-description">
                <%= project.description %>
            </p>

            <div class="detail-meta">
                <p><strong>Date:</strong>
                    <%= new Date(project.date).toLocaleDateString() %>
                </p>
                <p><strong>Location:</strong>
                    <%= project.location %>
                </p>
            </div>

            <h2 class="detail-section-title">Categories</h2>
            <% if (categories && categories.length > 0) { %>
                <ul class="category-list">
                    <% categories.forEach(category => { %>
                        <li class="category-item">
                            <a href="/category/<%= category.id %>" class="detail-link">
                                <%= category.name %>
                            </a>
                        </li>
                    <% }); %>
                </ul>
            <% } else { %>
                <p>No categories found for this project.</p>
            <% } %>

            <h2 class="detail-section-title">Organization</h2>
            <p>
                <a href="/organization/<%= project.organization_id %>" class="detail-link">
                    <%= project.organization_name %>
                </a>
            </p>
        </article>
    </main>

<%- include('partials/footer') %>