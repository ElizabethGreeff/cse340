<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <article class="detail-card">
            <p class="detail-description">
                <%= project.description %>
            </p>

            <div class="detail-meta">
                <p><strong>Date:</strong>
                    <%= new Date(project.date).toLocaleDateString() %>
                </p>
                <p><strong>Location:</strong>
                    <%= project.location %>
                </p>
            </div>

            <h2 class="detail-section-title">Categories</h2>
            <% if (categories && categories.length> 0) { %>
                <ul class="simple-list">
                    <% categories.forEach(category=> { %>
                        <li>
                            <a href="/category/<%= category.category_id %>" class="detail-link">
                                <%= category.name %>
                            </a>
                        </li>
                    <% }); %>
                </ul>
                <% } else { %>
                    <p>No categories found for this project.</p>
                <% } %>

                <h2 class="detail-section-title">Organization</h2>
                <p>
                    <a href="/organization/<%= project.organization_id %>" class="detail-link">
                        <%= project.organization_name %>
                    </a>
                </p>
                
                <% if (isLoggedIn) { %>
                    <h2 class="detail-section-title">Volunteer</h2>
                    <% if (isVolunteering) { %>
                        <p class="volunteer-status">You are volunteering for this project.</p>
                        <form action="/project/<%= project.project_id %>/unvolunteer" method="POST" class="inline-form">
                            <button type="submit" class="action-link action-link-secondary">Stop volunteering</button>
                        </form>
                    <% } else { %>
                        <form action="/project/<%= project.project_id %>/volunteer" method="POST" class="inline-form">
                            <button type="submit" class="action-link">Volunteer for this project</button>
                        </form>
                    <% } %>
                <% } %>
                
                <% if (user && user.role_name==='admin' ) { %>
                    <p class="action-row">
                        <a href="/assign-categories/<%= project.project_id %>" class="action-link">Edit
                            Categories</a>
                        <a href="/edit-project/<%= project.project_id %>" class="action-link">Edit Project</a>
                    </p>
                <% } %>
        </article>
    </main>

<%- include('partials/footer') %>