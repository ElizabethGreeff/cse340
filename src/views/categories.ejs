<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>
        <p class="page-intro">Explore different categories of service opportunities.</p>

        <ul class="category-list">
            <% categories.forEach(category=> { %>
                <li class="category-item">
                    <span class="category-name">
                        <a href="/category/<%= category.category_id %>" class="detail-link">
                            <%= category.name %>
                        </a>
                    </span>
                </li>
            <% }); %>
        </ul>
    </main>

<%- include('partials/footer') %>