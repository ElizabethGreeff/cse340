<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <article class="detail-card">
            <div class="org-header">
                <img src="/images/<%= organizationDetails.logo_filename %>" alt="<%= organizationDetails.name %> logo"
                    class="org-detail-logo">
                <div>
                    <h2 class="org-detail-name">
                        <%= organizationDetails.name %>
                    </h2>
                    <p class="org-detail-description">
                        <%= organizationDetails.description %>
                    </p>
                </div>
            </div>

            <h3 class="detail-section-title">Service Projects</h3>
            <ul class="simple-list">
                <% projects.forEach(project=> { %>
                    <li>
                        <a href="/project/<%= project.project_id %>" class="detail-link">
                            <%= project.title %>
                        </a>
                    </li>
                    <% }) %>
            </ul>
        </article>
    </main>

    <%- include('partials/footer') %>