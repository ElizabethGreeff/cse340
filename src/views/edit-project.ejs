<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <form action="/edit-project/<%= projectDetails.project_id %>" method="POST">
            <div class="form-group">
                <label for="title">Project Title</label>
                <input required type="text" id="title" name="title" maxlength="150" value="<%= projectDetails.title %>"/>
            </div>

            <div class="form-group">
                <label for="description">Description</label>
                <textarea required id="description" name="description" maxlength="500"><%= projectDetails.description %></textarea>
            </div>

            <div class="form-group">
                <label for="location">Location</label>
                <input required type="text" id="location" name="location" maxlength="255" value="<%= projectDetails.location %>"/>
            </div>

            <div class="form-group">
                <label for="date">Date</label>
                <input required type="date" id="date" name="date" value="<%= projectDetails.date %>"/>
            </div>

            <div class="form-group">
                <label for="organizationId">Organization</label>
                <select required id="organizationId" name="organizationId">
                    <% organizations.forEach(org => { %>
                        <option value="<%= org.organization_id %>" <%= org.organization_id === projectDetails.organization_id ? 'selected' : '' %>>
                            <%= org.name %>
                        </option>
                    <% }); %>
                </select>
            </div>

            <button type="submit">Update Project</button>
        </form>

    </main>

<%- include('partials/footer') %>