<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>
        <p class="page-intro">Here are a few of our partner organizations:</p>

        <ul class="org-list">
            <% organizations.forEach(organization=> { %>
                <li class="org-card">
                    <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo"
                        class="org-logo">
                    <div class="org-info">
                        <h3 class="org-name">
                            <a href="/organization/<%= organization.organization_id %>">
                                <%= organization.name %>
                            </a>
                        </h3>
                        <p class="org-email">
                            <%= organization.contact_email %>
                        </p>
                        <p class="org-description">
                            <%= organization.description %>
                        </p>
                    </div>
                </li>
            <% }); %>
        </ul>
        
        <% if (user && user.role_name==='admin' ) { %>
            <p class="action-row">
                <a href="/new-organization" class="btn">Add a new organization</a>
            </p>
        <% } %>
    </main>

    <%- include('partials/footer') %>