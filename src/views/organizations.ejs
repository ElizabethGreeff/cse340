<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>
        <p class="page-intro">Here are a few of our partner organizations:</p>

        <ul class="org-list">
            <% organizations.forEach(organization=> { %>
                <li class="org-card">
                    <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo"
                        class="org-logo">
                    <div class="org-info">
                        <h3 class="org-name">
                            <%= organization.name %>
                        </h3>
                        <p class="org-email">
                            <%= organization.contact_email %>
                        </p>
                        <p class="org-description">
                            <%= organization.description %>
                        </p>
                    </div>
                </li>
                <% }); %>
        </ul>
    </main>

    <%- include('partials/footer') %>