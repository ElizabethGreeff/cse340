<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>
        <p class="page-intro">Welcome back. Here's your account overview.</p>

        <article class="detail-card dashboard-card">
            <h2 class="detail-section-title">Account details</h2>

            <div class="dashboard-meta">
                <div class="dashboard-row">
                    <span class="dashboard-label">Name</span>
                    <span class="dashboard-value">
                        <%= name %>
                    </span>
                </div>
                <div class="dashboard-row">
                    <span class="dashboard-label">Email</span>
                    <span class="dashboard-value">
                        <%= email %>
                    </span>
                </div>
            </div>

            <% if (user && user.role_name==='admin' ) { %>
                <div class="dashboard-row">
                    <span class="dashboard-label">Role</span>
                    <span class="dashboard-value dashboard-role">
                        <%= user.role_name %>
                    </span>
                </div>
            <% } %>

            <p class="action-row">
                <% if (user && user.role_name==='admin' ) { %>
                    <a href="/users" class="action-link">View all users</a>
                <% } %>
                <a href="/" class="action-link action-link-secondary">Back to Home</a>
                <a href="/logout" class="action-link action-link-secondary">Log out</a>
        </p>
        </article>
    </main>

<%- include('partials/footer') %>